# ==============================================================================
# Acadexa AI - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your actual config.
# Do NOT commit your actual .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Acadexa AI API"

# ------------------------------------------------------------------------------
# Security
# Generate a secure key in bash/powershell with: openssl rand -hex 32
# ------------------------------------------------------------------------------
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Database (PostgreSQL / Neon)
# Local Docker: postgresql://postgres:postgrespassword@localhost:5432/acadexa
# Remote Neon:  postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/acadexa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=acadexa
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# AI Provider (OpenRouter) - Get your key at https://openrouter.ai/keys
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional Gemini Fallback
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Rate Limiting & Storage Limits
# ------------------------------------------------------------------------------
AI_RATE_LIMIT=30/minute
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# Cloudinary (Optional - remote file & document storage)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=acadexa-ai

# ------------------------------------------------------------------------------
# Frontend & CORS
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
